PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ironlog
# Where the Next.js app runs (CORS)
CLIENT_ORIGIN=http://localhost:3000
# Emails that become admin on first login (comma separated). The email must be verified.
ADMIN_EMAILS=you@example.com

# Firebase Admin credentials: Firebase console > Project settings > Service accounts > Generate new private key.
# Either point to the downloaded JSON file...
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# ...or set these three instead:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
